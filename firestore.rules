rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Criteria collection
    match /criteria/{criterionId} {
      allow read, write: if true;
    }

    // Results collection
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Files metadata collection
    match /files/{fileId} {
      allow read, write: if true;
    }

    // Ratings feedback collection
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Gemini evaluation audit records
    match /evaluations/{evaluationId} {
      allow read, write: if true;
    }

    // Compliance requirements checklist and audit records
    match /compliance_requirements/{reqId} {
      allow read, write: if true;
    }

    // Threaded team discussion comments for compliance items
    match /compliance_comments/{commentId} {
      allow read, write: if true;
    }

    // Global audit activity stream and bulk actions logging
    match /compliance_activities/{activityId} {
      allow read, write: if true;
    }

    // Catch-all for test connections and development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
